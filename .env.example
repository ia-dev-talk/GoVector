# BlueVector local development. Copy to .env and never commit real secrets.
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY

POSTGRES_USER=fieldopt
POSTGRES_PASSWORD=fieldopt
POSTGRES_DB=fieldopt
DATABASE_URL=postgresql+asyncpg://fieldopt:fieldopt@postgres:5432/fieldopt

BLUEVECTOR_HTTP_PORT=8080
BLUEVECTOR_POSTGRES_PORT=5432
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# Production/staging must override SECRET_KEY, DATABASE_URL and CORS_ORIGINS.
# BlueVector refuses known development defaults in these environments.
