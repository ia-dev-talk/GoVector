# BlueVector local development. Copy to .env and never commit real secrets.
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY

POSTGRES_USER=fieldopt
POSTGRES_PASSWORD=fieldopt
POSTGRES_DB=fieldopt
DATABASE_URL=postgresql+asyncpg://fieldopt:fieldopt@postgres:5432/fieldopt

BLUEVECTOR_HTTP_PORT=8080
BLUEVECTOR_POSTGRES_PORT=5432
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

# Praxedo integration (leave unset until the customer's official API contract is available).
# Never commit real credentials or tenant URLs. Endpoint paths come from the tenant docs;
# BlueVector intentionally ships with no guessed Praxedo paths.
# Required BlueVector operation aliases for the Sep 14 delivery contract:
#   technician_list, intervention_get, article_list,
#   work_report_write, stock_movement_write
# Example SHAPE only (do not copy guessed paths):
# PRAXEDO_ENDPOINTS_JSON={"technician_list":"<relative tenant path>",...}
# Non-secret diagnostic once configured:
# GET /api/v1/audit/integrations/readiness/praxedo
PRAXEDO_BASE_URL=
PRAXEDO_AUTH_MODE=basic
PRAXEDO_ENDPOINTS_JSON={}
PRAXEDO_HEADERS_JSON={}
PRAXEDO_USERNAME=
PRAXEDO_PASSWORD=
PRAXEDO_CLIENT_ID=
PRAXEDO_CLIENT_SECRET=
PRAXEDO_TOKEN_URL=
PRAXEDO_SCOPE=
PRAXEDO_TIMEOUT_SECONDS=20
PRAXEDO_MAX_RETRIES=2
# Set only when the tenant documentation explicitly confirms an idempotency header.
PRAXEDO_IDEMPOTENCY_HEADER=

# Production/staging must override SECRET_KEY, DATABASE_URL and CORS_ORIGINS.
# BlueVector refuses known development defaults in these environments.