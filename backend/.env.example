# Prefer the root .env.example when running Docker Compose.
APP_NAME=BlueVector
APP_VERSION=0.0.8
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=CHANGE_ME_SUPER_SECRET_KEY

DATABASE_URL=postgresql+asyncpg://fieldopt:fieldopt@localhost:5432/fieldopt
DATABASE_ECHO=false

API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
CORS_ORIGINS=["http://localhost:8080","http://localhost:5173"]

GEOCODING_ENABLED=true
GEOCODING_COUNTRY=Morocco
GEOCODING_COUNTRY_CODE=ma
GEOCODING_USER_AGENT=BlueVector-FTTH/0.0.8

# staging/production refuse the example secret, development database credentials,
# DEBUG/API_RELOAD and wildcard CORS. Store real secrets outside Git.
