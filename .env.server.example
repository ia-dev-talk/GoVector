# GoVector — serveur Linux local. Copier en .env et remplacer toutes les valeurs CHANGE_ME.
ENVIRONMENT=production
DEBUG=false
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

POSTGRES_USER=govector
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
POSTGRES_DB=govector
DATABASE_URL=postgresql+asyncpg://govector:CHANGE_ME_DATABASE_PASSWORD@postgres:5432/govector

BLUEVECTOR_HTTP_PORT=8080
BLUEVECTOR_POSTGRES_PORT=5432
CORS_ORIGINS=["http://CHANGE_ME_SERVER_IP:8080"]
IS_DEMO=false

# Aucune intégration payante n'est requise. Praxedo reste désactivé sans contrat API officiel.
PRAXEDO_BASE_URL=
PRAXEDO_ENDPOINTS_JSON={}
PRAXEDO_HEADERS_JSON={}
PRAXEDO_WRITE_CONTRACT_CONFIRMED=false
PRAXEDO_WRITE_CONTRACT_VERSION=
PRAXEDO_WRITE_METHODS_JSON={}
